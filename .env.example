# DNSE OpenAPI credentials (required)
DNSE_API_KEY=replace-with-api-key
DNSE_API_SECRET=replace-with-api-secret

# Production (default) or Sandbox
DNSE_BASE_URL=https://openapi.dnse.com.vn
# DNSE_BASE_URL=https://sb-openapi.dnse.com.vn

# API version header. Keep in sync with DNSE release notes.
DNSE_API_VERSION=2026-07-23

# Signing date header name. DNSE docs use "Date"; some spec snapshots use "X-Aux-Date".
DNSE_DATE_HEADER=Date

# Optional default sub-account
DNSE_ACCOUNT_NO=

# HTTP behaviour
DNSE_TIMEOUT=30
DNSE_MAX_RETRIES=2

# Local server
DNSE_SERVER_HOST=127.0.0.1
DNSE_SERVER_PORT=8000
# Optional shared secret required from local clients (recommended if the port is reachable
# by anything other than you). Sent as "X-Local-Token" or "Authorization: Bearer ...".
DNSE_SERVER_TOKEN=

# Optional Email OTP automation (IMAP). Only needed for login_with_email_otp().
DNSE_OTP_IMAP_HOST=imap.gmail.com
DNSE_OTP_IMAP_USER=
DNSE_OTP_IMAP_PASSWORD=
DNSE_OTP_SENDER=dnse
DNSE_OTP_SUBJECT=Email OTP

# Verbose transport logging (never logs secrets)
DNSE_DEBUG=false
